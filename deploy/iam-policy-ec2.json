{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DadosEFotosNoS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::NOME-DO-SEU-BUCKET/*"
    },
    {
      "Sid": "ConversarComOAgenteDoBedrock",
      "Effect": "Allow",
      "Action": "bedrock:InvokeAgent",
      "Resource": "arn:aws:bedrock:us-east-1:ID-DA-CONTA:agent-alias/*"
    }
  ]
}
