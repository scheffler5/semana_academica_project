# Copie para backend/.env e preencha com os valores da SUA conta.
# Na EC2 as credenciais AWS vêm da IAM Role da instância: NÃO coloque chaves de acesso aqui.

AWS_REGION=us-east-1

# Aurora PostgreSQL (endpoint "Writer" do cluster). Sem DB_HOST, o app usa SQLite local.
DB_HOST=
DB_PORT=5432
DB_NAME=estoque
DB_USER=postgres
DB_PASSWORD=

# Bucket S3 das fotos dos itens
S3_BUCKET=

# Agente de IA: "simulado" (local, sem LLM) ou "bedrock".
# Se ficar vazio: usa "bedrock" quando BEDROCK_AGENT_ID estiver preenchido, senão "simulado".
AGENT_MODE=
# No modo simulado, endereço da API que a Lambda (rodando localmente) chama
LOCAL_API_URL=http://127.0.0.1:8000

# Bedrock Agent (IDs do console do Bedrock > Agents)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

SEED_DATA=true
